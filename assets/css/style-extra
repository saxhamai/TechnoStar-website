/* =========================================================
   SaXham Technologies — Homepage visual refresh
   File: assets/css/style-extra.css
   Loaded after style.css. These rules intentionally refine
   the existing HTML without changing its class structure.
   ========================================================= */

/* ---------- Design tokens ---------- */
:root {
  --sx-navy: #0a2540;
  --sx-navy-deep: #071b30;
  --sx-blue: #1769aa;
  --sx-blue-bright: #247fc1;
  --sx-blue-soft: #eaf3fb;
  --sx-gold: #d6ad52;
  --sx-gold-soft: #fbf5e8;
  --sx-ink: #172b3e;
  --sx-muted: #627487;
  --sx-line: #e2eaf1;
  --sx-surface: #ffffff;
  --sx-surface-soft: #f4f7fa;
  --sx-shadow-sm: 0 8px 24px rgba(10, 37, 64, .07);
  --sx-shadow-md: 0 18px 48px rgba(10, 37, 64, .12);
  --sx-radius: 18px;
  --sx-radius-lg: 26px;
  --sx-content: 1180px;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 100px;
}

body {
  color: var(--sx-ink);
  background: var(--sx-surface);
  font-family: "Inter", Arial, sans-serif;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
}

img {
  max-width: 100%;
}

.container {
  width: min(var(--sx-content), calc(100% - 48px));
  margin-inline: auto;
}

.container-sm {
  width: min(820px, calc(100% - 48px));
}

.section {
  padding-block: clamp(64px, 7vw, 100px);
}

.bg-light {
  background: var(--sx-surface-soft);
}

.section-header {
  max-width: 760px;
  margin: 0 auto 42px;
  text-align: center;
}

.section-tag {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 12px;
  color: var(--sx-blue);
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .12em;
  line-height: 1.4;
  text-transform: uppercase;
}

.section-header h2,
.section h2,
.industries-section h2,
.highlights-section h2 {
  margin: 0 0 14px;
  color: var(--sx-navy);
  font-family: "Poppins", "Inter", sans-serif;
  font-size: clamp(1.8rem, 3.4vw, 2.65rem);
  font-weight: 700;
  letter-spacing: -.035em;
  line-height: 1.2;
}

.section-header p,
.section > .container p,
.industries-section .section-header p {
  color: var(--sx-muted);
}

a {
  text-underline-offset: 3px;
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
select:focus-visible,
textarea:focus-visible {
  outline: 3px solid rgba(36, 127, 193, .55);
  outline-offset: 3px;
}

/* ---------- Top information bar ---------- */
.top-bar {
  position: relative;
  z-index: 1002;
  background: var(--sx-navy-deep);
  color: rgba(255,255,255,.86);
  font-size: .78rem;
}

.top-bar .container,
.top-left,
.top-right {
  display: flex;
  align-items: center;
}

.top-bar .container {
  min-height: 38px;
  justify-content: space-between;
  gap: 18px;
}

.top-left,
.top-right {
  flex-wrap: wrap;
  gap: 18px;
}

.top-bar span,
.top-bar a {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  color: inherit;
  text-decoration: none;
}

.top-bar i {
  color: var(--sx-gold);
}

.top-bar a:hover {
  color: #fff;
}

/* ---------- Main navigation ---------- */
.main-header {
  position: sticky;
  top: 0;
  z-index: 1001;
  background: rgba(255,255,255,.96);
  border-bottom: 1px solid rgba(226,234,241,.9);
  box-shadow: 0 4px 18px rgba(10,37,64,.035);
  backdrop-filter: blur(14px);
}

.navbar {
  display: flex;
  min-height: 82px;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
}

.brand {
  display: inline-flex;
  min-width: max-content;
  align-items: center;
  gap: 11px;
  color: var(--sx-navy);
  text-decoration: none;
}

.brand-logo-img {
  display: block;
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.brand-text h1 {
  margin: 0;
  color: var(--sx-navy);
  font-family: "Poppins", sans-serif;
  font-size: 1.12rem;
  font-weight: 800;
  letter-spacing: -.035em;
  line-height: 1.2;
}

.brand-text p {
  margin: 4px 0 0;
  color: var(--sx-blue);
  font-size: .69rem;
  font-weight: 700;
  letter-spacing: .075em;
  line-height: 1.2;
  text-transform: uppercase;
}

.main-header nav {
  margin-left: auto;
}

.nav-menu {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: clamp(10px, 1.35vw, 21px);
  margin: 0;
  padding: 0;
  list-style: none;
}

.nav-link {
  position: relative;
  display: inline-flex;
  align-items: center;
  min-height: 42px;
  color: #34495d;
  font-size: .79rem;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
  transition: color .2s ease;
}

.nav-link::after {
  position: absolute;
  right: 0;
  bottom: 2px;
  left: 0;
  height: 2px;
  background: var(--sx-gold);
  border-radius: 2px;
  content: "";
  transform: scaleX(0);
  transform-origin: left;
  transition: transform .2s ease;
}

.nav-link:hover,
.nav-link.active {
  color: var(--sx-blue);
}

.nav-link:hover::after,
.nav-link.active::after {
  transform: scaleX(1);
}

.nav-actions {
  flex-shrink: 0;
}

.btn {
  display: inline-flex;
  min-height: 48px;
  align-items: center;
  justify-content: center;
  gap: 9px;
  padding: 12px 21px;
  border: 1px solid transparent;
  border-radius: 10px;
  font-family: "Inter", sans-serif;
  font-size: .88rem;
  font-weight: 750;
  line-height: 1.2;
  text-align: center;
  text-decoration: none;
  cursor: pointer;
  transition: transform .2s ease, box-shadow .2s ease, background .2s ease, border-color .2s ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn-primary {
  background: var(--sx-blue);
  color: #fff;
  box-shadow: 0 8px 18px rgba(23,105,170,.18);
}

.btn-primary:hover {
  background: var(--sx-navy);
  box-shadow: 0 12px 24px rgba(10,37,64,.2);
}

.btn-whatsapp {
  background: #168b58;
  color: #fff;
  box-shadow: 0 8px 18px rgba(22,139,88,.16);
}

.btn-whatsapp:hover {
  background: #117448;
}

.btn-outline {
  border-color: rgba(23,105,170,.3);
  background: #fff;
  color: var(--sx-blue);
}

.btn-outline:hover {
  border-color: var(--sx-blue);
  background: var(--sx-blue-soft);
}

.mobile-toggle {
  display: none;
  width: 44px;
  height: 44px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--sx-line);
  border-radius: 10px;
  background: #fff;
  color: var(--sx-navy);
  font-size: 1.2rem;
  cursor: pointer;
}

/* ---------- Mobile drawer ---------- */
.mobile-overlay {
  position: fixed;
  z-index: 1100;
  inset: 0;
  background: rgba(4,18,32,.58);
  opacity: 0;
  pointer-events: none;
  transition: opacity .25s ease;
}

.mobile-menu {
  position: fixed;
  z-index: 1101;
  top: 0;
  right: 0;
  display: flex;
  width: min(390px, 88vw);
  height: 100dvh;
  flex-direction: column;
  padding: 22px;
  overflow-y: auto;
  background: #fff;
  box-shadow: -20px 0 50px rgba(4,18,32,.18);
  transform: translateX(105%);
  visibility: hidden;
  transition: transform .28s ease, visibility .28s ease;
}

.mobile-menu.active,
.mobile-menu.open,
.mobile-menu.is-open {
  transform: translateX(0);
  visibility: visible;
}

.mobile-overlay.active,
.mobile-overlay.open,
.mobile-overlay.is-open {
  opacity: 1;
  pointer-events: auto;
}

.mobile-menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding-bottom: 22px;
  border-bottom: 1px solid var(--sx-line);
}

.mobile-brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.mobile-logo {
  width: 44px;
  height: 44px;
  object-fit: contain;
}

.mobile-brand h3 {
  margin: 0;
  color: var(--sx-navy);
  font-size: .98rem;
}

.mobile-brand p {
  margin: 2px 0 0;
  color: var(--sx-blue);
  font-size: .7rem;
  font-weight: 700;
}

.mobile-close {
  display: inline-flex;
  width: 40px;
  height: 40px;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--sx-line);
  border-radius: 9px;
  background: #fff;
  color: var(--sx-navy);
  font-size: 1.1rem;
  cursor: pointer;
}

.mobile-nav {
  display: grid;
  gap: 5px;
  margin: 20px 0;
  padding: 0;
  list-style: none;
}

.mobile-link {
  display: flex;
  min-height: 48px;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 9px;
  color: #34495d;
  font-weight: 700;
  text-decoration: none;
}

.mobile-link i {
  width: 20px;
  color: var(--sx-blue);
  text-align: center;
}

.mobile-link:hover,
.mobile-link.active {
  background: var(--sx-blue-soft);
  color: var(--sx-blue);
}

.mobile-actions {
  display: grid;
  gap: 10px;
  margin-top: auto;
  padding-top: 18px;
}

.btn-block {
  width: 100%;
}

/* ---------- Hero ---------- */
.hero-section {
  position: relative;
  isolation: isolate;
  padding: clamp(68px, 8vw, 112px) 0 clamp(70px, 8vw, 105px);
  overflow: hidden;
  background:
    radial-gradient(circle at 80% 18%, rgba(214,173,82,.15), transparent 27%),
    linear-gradient(120deg, #f5f9fd 0%, #edf5fb 52%, #f9fbfd 100%);
}

.hero-grid {
  position: absolute;
  z-index: -1;
  inset: 0;
  background-image: linear-gradient(rgba(23,105,170,.045) 1px, transparent 1px), linear-gradient(90deg, rgba(23,105,170,.045) 1px, transparent 1px);
  background-size: 42px 42px;
  mask-image: linear-gradient(to right, transparent, #000 40%, #000);
  pointer-events: none;
}

.hero-gradient {
  position: absolute;
  z-index: -1;
  top: -240px;
  right: -170px;
  width: 620px;
  height: 620px;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(36,127,193,.13), transparent 68%);
  pointer-events: none;
}

.hero-container {
  display: grid;
  grid-template-columns: minmax(0, 1.04fr) minmax(390px, .96fr);
  align-items: center;
  gap: clamp(30px, 5vw, 72px);
}

.hero-content {
  position: relative;
  z-index: 2;
  max-width: 660px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin: 0 0 20px;
  padding: 8px 13px;
  border: 1px solid rgba(23,105,170,.14);
  border-radius: 999px;
  background: rgba(255,255,255,.8);
  color: var(--sx-blue);
  font-size: .76rem;
  font-weight: 800;
  letter-spacing: .035em;
}

.hero-title {
  margin: 0;
  color: var(--sx-navy);
  font-family: "Poppins", "Inter", sans-serif;
  font-size: clamp(2.5rem, 5.1vw, 4.35rem);
  font-weight: 800;
  letter-spacing: -.055em;
  line-height: 1.1;
}

.hero-title span {
  display: block;
  color: var(--sx-blue);
}

.hero-subtitle {
  max-width: 610px;
  margin: 22px 0 27px;
  color: #53697d;
  font-size: clamp(1rem, 1.3vw, 1.12rem);
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.tech-stack {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 28px;
}

.tech-badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 11px;
  border: 1px solid #dce8f2;
  border-radius: 8px;
  background: rgba(255,255,255,.8);
  color: #3c566d;
  font-size: .76rem;
  font-weight: 700;
}

.tech-badge i {
  color: var(--sx-blue);
}

.hero-visual {
  position: relative;
  display: grid;
  min-height: 440px;
  place-items: center;
}

.hero-image-wrapper {
  position: relative;
  z-index: 1;
  display: grid;
  width: min(100%, 510px);
  min-height: 360px;
  place-items: center;
}

.hero-main-image {
  display: block;
  width: 100%;
  max-height: 440px;
  object-fit: contain;
  filter: drop-shadow(0 24px 32px rgba(10,37,64,.1));
}

.hero-circle {
  position: absolute;
  border: 1px solid rgba(23,105,170,.13);
  border-radius: 50%;
  pointer-events: none;
}

.hero-circle-1 {
  width: 420px;
  height: 420px;
}

.hero-circle-2 {
  width: 330px;
  height: 330px;
}

.hero-circle-3 {
  width: 230px;
  height: 230px;
  background: rgba(255,255,255,.34);
}

.hero-dots {
  position: absolute;
  top: 8%;
  right: 4%;
  width: 90px;
  height: 90px;
  background-image: radial-gradient(var(--sx-gold) 1.5px, transparent 1.5px);
  background-size: 12px 12px;
  opacity: .65;
}

.hero-floating-card {
  position: absolute;
  z-index: 2;
  display: flex;
  min-width: 190px;
  align-items: center;
  gap: 11px;
  padding: 12px 14px;
  border: 1px solid rgba(226,234,241,.9);
  border-radius: 13px;
  background: rgba(255,255,255,.96);
  box-shadow: var(--sx-shadow-md);
  backdrop-filter: blur(8px);
}

.card-one {
  top: 13%;
  left: -3%;
}

.card-two {
  top: 43%;
  right: -5%;
}

.card-three {
  bottom: 12%;
  left: 0;
}

.floating-icon {
  display: grid;
  width: 39px;
  height: 39px;
  flex: 0 0 39px;
  place-items: center;
  border-radius: 10px;
  background: var(--sx-blue-soft);
  color: var(--sx-blue);
  font-size: 1rem;
}

.floating-content span {
  display: block;
  color: #8191a0;
  font-size: .67rem;
  font-weight: 700;
}

.floating-content strong {
  display: block;
  color: var(--sx-navy);
  font-size: .82rem;
  line-height: 1.35;
}

/* ---------- Four service pillars ---------- */
#service-categories {
  padding-block: clamp(64px, 7vw, 96px);
  background: #fff;
}

.services-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 22px;
}

.enterprise-service-card {
  position: relative;
  display: flex;
  min-width: 0;
  flex-direction: column;
  padding: clamp(22px, 3vw, 30px);
  border: 1px solid var(--sx-line);
  border-radius: var(--sx-radius);
  background: #fff;
  box-shadow: 0 5px 20px rgba(10,37,64,.035);
  transition: transform .25s ease, border-color .25s ease, box-shadow .25s ease;
}

.enterprise-service-card:hover {
  transform: translateY(-6px);
  border-color: rgba(23,105,170,.32);
  box-shadow: var(--sx-shadow-md);
}

.service-header {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 16px;
}

.service-icon {
  display: grid;
  width: 56px;
  height: 56px;
  flex: 0 0 56px;
  place-items: center;
  border-radius: 15px;
  background: var(--sx-blue-soft);
  color: var(--sx-blue);
  font-size: 1.35rem;
}

.enterprise-service-card:nth-child(2) .service-icon {
  background: var(--sx-gold-soft);
  color: #a7781d;
}

.enterprise-service-card:nth-child(3) .service-icon {
  background: #eaf6f1;
  color: #168b58;
}

.enterprise-service-card:nth-child(4) .service-icon {
  background: #f1edfb;
  color: #7655b7;
}

.service-category {
  display: block;
  margin-bottom: 4px;
  color: var(--sx-blue);
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.service-title {
  margin: 0;
  color: var(--sx-navy);
  font-family: "Poppins", sans-serif;
  font-size: 1.18rem;
  font-weight: 700;
  line-height: 1.35;
}

.service-description {
  margin: 0 0 17px;
  color: var(--sx-muted);
  font-size: .91rem;
  line-height: 1.75;
}

.service-list {
  display: grid;
  gap: 9px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.service-list li {
  display: flex;
  align-items: flex-start;
  gap: 9px;
  color: #40566a;
  font-size: .87rem;
  line-height: 1.55;
}

.service-list li i {
  flex: 0 0 auto;
  margin-top: 4px;
  color: #219568;
  font-size: .82rem;
}

.service-footer {
  margin-top: auto;
  padding-top: 23px;
}

.service-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--sx-blue);
  font-size: .88rem;
  font-weight: 800;
  text-decoration: none;
}

.service-link i {
  transition: transform .2s ease;
}

.service-link:hover i {
  transform: translateX(4px);
}

/* ---------- Service detail sections ---------- */
.detail-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
  align-items: center;
  gap: clamp(35px, 6vw, 76px);
}

.detail-grid > div > img {
  display: block;
  width: 100%;
  max-height: 440px;
  object-fit: contain;
  border-radius: var(--sx-radius-lg);
}

.detail-grid .service-list {
  margin-top: 22px;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  column-gap: 18px;
}

.mt-40 {
  margin-top: 28px;
}

/* ---------- Process / how it works ---------- */
.timeline {
  position: relative;
  display: grid;
  gap: 16px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.timeline-item {
  position: relative;
  padding-left: 34px;
}

.timeline-dot {
  position: absolute;
  top: 24px;
  left: 3px;
  width: 13px;
  height: 13px;
  border: 3px solid #fff;
  border-radius: 50%;
  background: var(--sx-blue);
  box-shadow: 0 0 0 2px var(--sx-blue);
}

.timeline-item:not(:last-child)::before {
  position: absolute;
  top: 39px;
  bottom: -22px;
  left: 9px;
  width: 2px;
  background: #d7e5f0;
  content: "";
}

.timeline-card {
  padding: 20px 23px;
  border: 1px solid var(--sx-line);
  border-radius: 13px;
  background: #fff;
  box-shadow: 0 5px 16px rgba(10,37,64,.035);
}

.timeline-date {
  color: var(--sx-blue);
  font-size: .7rem;
  font-weight: 800;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.timeline-title {
  margin: 5px 0;
  color: var(--sx-navy);
  font-size: 1.04rem;
}

.timeline-text {
  margin: 0;
  color: var(--sx-muted);
  font-size: .9rem;
}

/* ---------- Founder and trust sections ---------- */
.founder-block {
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr);
  align-items: center;
  gap: 35px;
  padding: clamp(25px, 4vw, 48px);
  border: 1px solid var(--sx-line);
  border-radius: var(--sx-radius-lg);
  background: linear-gradient(135deg, #fff 0%, #f2f7fb 100%);
  box-shadow: var(--sx-shadow-sm);
}

.founder-avatar {
  display: grid;
  width: 138px;
  height: 138px;
  place-items: center;
  border: 1px solid #dce8f2;
  border-radius: 50%;
  background: linear-gradient(145deg, #e9f3fb, #fff);
  color: var(--sx-blue);
  font-size: 3.5rem;
}

.founder-block h2 {
  margin: 0 0 13px;
  color: var(--sx-navy);
  font-family: "Poppins", sans-serif;
  font-size: clamp(1.55rem, 2.7vw, 2.15rem);
  line-height: 1.25;
}

.founder-block p {
  color: var(--sx-muted);
}

.founder-highlights {
  display: flex;
  flex-wrap: wrap;
  gap: 10px 20px;
  margin: 18px 0 0;
  padding: 0;
  list-style: none;
}

.founder-highlights li {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #40566a;
  font-size: .86rem;
}

.founder-highlights i {
  color: #219568;
}

.highlights-section,
.industries-section {
  padding-block: clamp(64px, 7vw, 96px);
  background: var(--sx-surface-soft);
}

.highlight-grid,
.industries-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 18px;
}

.highlight-card,
.industry-card {
  padding: 25px 21px;
  border: 1px solid var(--sx-line);
  border-radius: 15px;
  background: #fff;
  box-shadow: 0 5px 18px rgba(10,37,64,.035);
  transition: transform .2s ease, box-shadow .2s ease;
}

.highlight-card:hover,
.industry-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--sx-shadow-sm);
}

.highlight-icon,
.industry-icon {
  display: grid;
  width: 48px;
  height: 48px;
  margin-bottom: 16px;
  place-items: center;
  border-radius: 13px;
  background: var(--sx-blue-soft);
  color: var(--sx-blue);
  font-size: 1.2rem;
}

.highlight-card h3,
.industry-card h3 {
  margin: 0 0 8px;
  color: var(--sx-navy);
  font-family: "Poppins", sans-serif;
  font-size: 1rem;
  line-height: 1.4;
}

.highlight-card p,
.industry-card p {
  margin: 0;
  color: var(--sx-muted);
  font-size: .85rem;
  line-height: 1.7;
}

/* ---------- Blog cards ---------- */
.blog-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 22px;
}

.blog-card {
  min-width: 0;
  overflow: hidden;
  border: 1px solid var(--sx-line);
  border-radius: 16px;
  background: #fff;
  box-shadow: 0 6px 20px rgba(10,37,64,.045);
  transition: transform .22s ease, box-shadow .22s ease;
}

.blog-card:hover {
  transform: translateY(-5px);
  box-shadow: var(--sx-shadow-md);
}

.blog-image {
  aspect-ratio: 16 / 9;
  overflow: hidden;
  background: var(--sx-surface-soft);
}

.blog-image img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform .35s ease;
}

.blog-card:hover .blog-image img {
  transform: scale(1.04);
}

.blog-content {
  padding: 21px;
}

.blog-title {
  margin: 0 0 9px;
  color: var(--sx-navy);
  font-family: "Poppins", sans-serif;
  font-size: 1.04rem;
  line-height: 1.45;
}

.blog-title a {
  color: inherit;
  text-decoration: none;
}

.blog-title a:hover {
  color: var(--sx-blue);
}

.blog-excerpt {
  margin: 0 0 16px;
  color: var(--sx-muted);
  font-size: .87rem;
}

.blog-readmore {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--sx-blue);
  font-size: .84rem;
  font-weight: 800;
  text-decoration: none;
}

/* ---------- FAQ ---------- */
.accordion {
  display: grid;
  gap: 12px;
}

.accordion-item {
  overflow: hidden;
  border: 1px solid var(--sx-line);
  border-radius: 12px;
  background: #fff;
  box-shadow: 0 4px 14px rgba(10,37,64,.025);
}

.accordion-header {
  display: flex;
  width: 100%;
  min-height: 62px;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  padding: 17px 20px;
  border: 0;
  background: #fff;
  color: var(--sx-navy);
  font: 700 .96rem/1.45 "Inter", sans-serif;
  text-align: left;
  cursor: pointer;
}

.accordion-header i {
  flex: 0 0 auto;
  color: var(--sx-blue);
  transition: transform .2s ease;
}

.accordion-item.active .accordion-header {
  color: var(--sx-blue);
}

.accordion-item.active .accordion-header i {
  transform: rotate(180deg);
}

.accordion-body {
  display: grid;
  grid-template-rows: 0fr;
  transition: grid-template-rows .25s ease;
}

.accordion-item.active .accordion-body {
  grid-template-rows: 1fr;
}

.accordion-content {
  overflow: hidden;
}

.accordion-content p {
  margin: 0;
  padding: 0 20px 19px;
  color: var(--sx-muted);
  font-size: .9rem;
}

/* ---------- CTA ---------- */
.cta-banner {
  position: relative;
  padding-block: clamp(58px, 7vw, 88px);
  overflow: hidden;
  background:
    radial-gradient(circle at 90% 0%, rgba(214,173,82,.22), transparent 30%),
    linear-gradient(120deg, var(--sx-navy-deep), #10436e);
}

.cta-wrapper {
  max-width: 820px;
  margin-inline: auto;
  text-align: center;
}

.cta-wrapper .section-tag {
  color: #f0cc78;
}

.cta-wrapper h2 {
  margin: 0 0 15px;
  color: #fff;
  font-family: "Poppins", sans-serif;
  font-size: clamp(1.9rem, 4vw, 3rem);
  line-height: 1.2;
}

.cta-wrapper p {
  max-width: 680px;
  margin: 0 auto 25px;
  color: rgba(255,255,255,.78);
}

.cta-buttons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px;
}

.cta-buttons .btn-outline {
  border-color: rgba(255,255,255,.4);
  background: transparent;
  color: #fff;
}

.cta-buttons .btn-outline:hover {
  background: rgba(255,255,255,.1);
}

/* ---------- Contact form ---------- */
.card {
  padding: clamp(22px, 4vw, 34px);
  border: 1px solid var(--sx-line);
  border-radius: var(--sx-radius);
  background: #fff;
  box-shadow: var(--sx-shadow-sm);
}

.contact-form {
  display: grid;
  gap: 16px;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 15px;
}

.form-group {
  display: grid;
  gap: 7px;
}

.form-group label {
  color: var(--sx-navy);
  font-size: .83rem;
  font-weight: 700;
}

.form-group input,
.form-group select,
.form-group textarea,
.contact-form input,
.contact-form select,
.contact-form textarea {
  width: 100%;
  min-height: 49px;
  padding: 12px 14px;
  border: 1px solid #d7e2eb;
  border-radius: 9px;
  background: #fbfdff;
  color: var(--sx-ink);
  font: 400 .92rem/1.5 "Inter", sans-serif;
  transition: border-color .2s ease, box-shadow .2s ease, background .2s ease;
}

.contact-form textarea,
.form-group textarea {
  min-height: 135px;
  resize: vertical;
}

.contact-form input::placeholder,
.contact-form textarea::placeholder {
  color: #8a9aaa;
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
  border-color: var(--sx-blue);
  outline: 0;
  background: #fff;
  box-shadow: 0 0 0 4px rgba(23,105,170,.1);
}

.contact-form .btn {
  width: 100%;
  border: 0;
}

.form-note {
  color: var(--sx-muted);
  font-size: .78rem;
  line-height: 1.6;
}

/* ---------- Footer ---------- */
.footer {
  padding-top: 62px;
  background: #071b30;
  color: rgba(255,255,255,.72);
}

.footer-grid {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr 1fr;
  gap: 36px;
  padding-bottom: 42px;
}

.footer-brand {
  display: flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 16px;
}

.footer-logo img {
  display: block;
  width: 48px;
  height: 48px;
  object-fit: contain;
}

.footer-brand-text h3 {
  margin: 0;
  color: #fff;
  font-family: "Poppins", sans-serif;
  font-size: 1.05rem;
}

.footer-brand-text p {
  margin: 3px 0 0;
  color: #e4c16d;
  font-size: .7rem;
  font-weight: 700;
}

.footer-description {
  max-width: 340px;
  margin: 0;
  color: rgba(255,255,255,.65);
  font-size: .87rem;
}

.footer-title {
  margin: 5px 0 18px;
  color: #fff;
  font-family: "Poppins", sans-serif;
  font-size: .98rem;
}

.footer-links {
  display: grid;
  gap: 10px;
}

.footer-links a,
.footer-contact a,
.footer-bottom a {
  color: rgba(255,255,255,.68);
  font-size: .84rem;
  text-decoration: none;
  transition: color .2s ease;
}

.footer-links a {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}

.footer-links a i {
  margin-top: 5px;
  color: var(--sx-gold);
  font-size: .65rem;
}

.footer-links a:hover,
.footer-contact a:hover,
.footer-bottom a:hover {
  color: #fff;
}

.footer-contact {
  display: grid;
  gap: 13px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.footer-contact li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  color: rgba(255,255,255,.68);
  font-size: .84rem;
  overflow-wrap: anywhere;
}

.footer-contact li > i {
  margin-top: 5px;
  color: var(--sx-gold);
}

.footer-bottom {
  border-top: 1px solid rgba(255,255,255,.12);
}

.footer-bottom-container {
  display: flex;
  min-height: 66px;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.footer-copy {
  margin: 0;
  color: rgba(255,255,255,.55);
  font-size: .78rem;
}

/* ---------- Floating actions / progress / utilities ---------- */
.floating-buttons {
  position: fixed;
  z-index: 990;
  right: 22px;
  bottom: 24px;
  display: grid;
  gap: 11px;
}

.float-btn {
  display: grid;
  width: 52px;
  height: 52px;
  place-items: center;
  border: 2px solid rgba(255,255,255,.9);
  border-radius: 50%;
  color: #fff;
  font-size: 1.25rem;
  text-decoration: none;
  box-shadow: 0 7px 22px rgba(10,37,64,.2);
  transition: transform .2s ease;
}

.float-btn:hover {
  transform: translateY(-3px) scale(1.04);
}

.float-whatsapp {
  background: #168b58;
}

.float-call {
  background: var(--sx-blue);
}

.back-to-top {
  position: fixed;
  z-index: 989;
  right: 29px;
  bottom: 151px;
  display: grid;
  width: 40px;
  height: 40px;
  place-items: center;
  border: 0;
  border-radius: 10px;
  background: var(--sx-navy);
  color: #fff;
  box-shadow: var(--sx-shadow-sm);
  cursor: pointer;
  opacity: 0;
  visibility: hidden;
  transform: translateY(8px);
  transition: opacity .2s ease, transform .2s ease, visibility .2s ease;
}

.back-to-top.show,
.back-to-top.visible,
.back-to-top.active {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

#progress-bar {
  position: fixed;
  z-index: 1200;
  top: 0;
  left: 0;
  width: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--sx-blue), var(--sx-gold));
}

/* ---------- Common helpers ---------- */
.text-center {
  text-align: center;
}

.w-100 {
  width: 100%;
}

.skip-link {
  position: absolute;
  z-index: 2000;
  top: 8px;
  left: 8px;
  padding: 10px 14px;
  border-radius: 7px;
  background: var(--sx-navy);
  color: #fff;
  transform: translateY(-150%);
}

.skip-link:focus {
  transform: translateY(0);
}

.testimonials-placeholder {
  max-width: 720px;
  margin-inline: auto;
  padding: 35px;
  border: 1px dashed #cbd9e5;
  border-radius: 16px;
  background: #fff;
}

.testimonials-placeholder > i {
  color: var(--sx-blue);
  font-size: 2rem;
}

.testimonials-placeholder h3 {
  color: var(--sx-navy);
}

/* ---------- Tablet ---------- */
@media (max-width: 1100px) {
  .navbar {
    gap: 14px;
  }

  .brand-logo-img {
    width: 43px;
    height: 43px;
  }

  .brand-text h1 {
    font-size: 1rem;
  }

  .brand-text p {
    font-size: .62rem;
  }

  .nav-menu {
    gap: 10px;
  }

  .nav-link {
    font-size: .72rem;
  }

  .nav-actions .btn {
    min-height: 42px;
    padding: 10px 13px;
    font-size: .77rem;
  }

  .hero-container {
    grid-template-columns: minmax(0, 1fr) minmax(320px, .9fr);
    gap: 28px;
  }

  .hero-floating-card {
    min-width: 165px;
    padding: 10px;
  }

  .highlight-grid,
  .industries-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ---------- Mobile / compact tablet ---------- */
@media (max-width: 820px) {
  .container,
  .container-sm {
    width: min(100% - 36px, var(--sx-content));
  }

  .top-bar .container {
    justify-content: center;
    padding-block: 7px;
  }

  .top-left {
    justify-content: center;
    gap: 8px 15px;
  }

  .top-right {
    display: none;
  }

  .navbar {
    min-height: 70px;
  }

  .main-header nav,
  .nav-actions {
    display: none;
  }

  .mobile-toggle {
    display: inline-flex;
    flex: 0 0 auto;
  }

  .hero-section {
    padding-block: 58px 64px;
  }

  .hero-container {
    grid-template-columns: 1fr;
    gap: 22px;
  }

  .hero-content {
    max-width: 720px;
    text-align: center;
    margin-inline: auto;
  }

  .hero-badge,
  .tech-stack {
    justify-content: center;
  }

  .hero-title {
    font-size: clamp(2.35rem, 8vw, 3.5rem);
  }

  .hero-subtitle {
    margin-inline: auto;
  }

  .hero-actions {
    justify-content: center;
  }

  .hero-visual {
    min-height: 370px;
  }

  .hero-image-wrapper {
    min-height: 330px;
    width: min(100%, 450px);
  }

  .hero-main-image {
    max-height: 350px;
  }

  .hero-circle-1 {
    width: 340px;
    height: 340px;
  }

  .hero-circle-2 {
    width: 270px;
    height: 270px;
  }

  .hero-circle-3 {
    width: 190px;
    height: 190px;
  }

  .card-one {
    top: 5%;
    left: 1%;
  }

  .card-two {
    top: 38%;
    right: 0;
  }

  .card-three {
    bottom: 3%;
    left: 2%;
  }

  .detail-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .detail-grid > div:first-child:has(img) {
    order: 0;
  }

  .founder-block {
    grid-template-columns: 1fr;
    gap: 20px;
    text-align: center;
  }

  .founder-avatar {
    width: 110px;
    height: 110px;
    margin-inline: auto;
    font-size: 2.8rem;
  }

  .founder-highlights {
    justify-content: center;
  }

  .blog-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

/* ---------- Small mobile ---------- */
@media (max-width: 560px) {
  .container,
  .container-sm {
    width: calc(100% - 32px);
  }

  .section {
    padding-block: 58px;
  }

  .section-header {
    margin-bottom: 30px;
  }

  .section-header h2,
  .section h2,
  .industries-section h2,
  .highlights-section h2 {
    font-size: 1.75rem;
  }

  .brand-logo-img {
    width: 41px;
    height: 41px;
  }

  .brand-text h1 {
    font-size: .96rem;
  }

  .brand-text p {
    font-size: .59rem;
    letter-spacing: .05em;
  }

  .hero-section {
    padding-block: 48px 45px;
  }

  .hero-title {
    font-size: clamp(2.05rem, 10vw, 2.8rem);
    line-height: 1.13;
  }

  .hero-subtitle {
    margin-top: 17px;
    font-size: .94rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: grid;
    grid-template-columns: 1fr;
    width: min(100%, 360px);
    margin-inline: auto;
  }

  .hero-actions .btn {
    width: 100%;
  }

  .tech-stack {
    gap: 7px;
    margin-top: 20px;
  }

  .tech-badge {
    padding: 7px 9px;
    font-size: .69rem;
  }

  .hero-visual {
    min-height: 285px;
    margin-top: 3px;
  }

  .hero-image-wrapper {
    min-height: 265px;
    width: 100%;
  }

  .hero-main-image {
    max-height: 270px;
  }

  .hero-circle-1 {
    width: 270px;
    height: 270px;
  }

  .hero-circle-2 {
    width: 215px;
    height: 215px;
  }

  .hero-circle-3 {
    width: 155px;
    height: 155px;
  }

  .hero-floating-card {
    min-width: 0;
    max-width: 164px;
    gap: 8px;
    padding: 8px 9px;
  }

  .floating-icon {
    width: 32px;
    height: 32px;
    flex-basis: 32px;
    font-size: .88rem;
  }

  .floating-content span {
    font-size: .59rem;
  }

  .floating-content strong {
    font-size: .7rem;
  }

  .card-one {
    top: 0;
    left: 0;
  }

  .card-two {
    top: 39%;
    right: 0;
  }

  .card-three {
    bottom: 0;
    left: 0;
  }

  .services-grid,
  .blog-grid,
  .highlight-grid,
  .industries-grid,
  .detail-grid .service-list,
  .form-row {
    grid-template-columns: 1fr;
  }

  .enterprise-service-card {
    padding: 22px;
  }

  .service-title {
    font-size: 1.08rem;
  }

  .detail-grid > div > img {
    max-height: 300px;
  }

  .founder-block {
    padding: 24px 19px;
  }

  .founder-highlights {
    display: grid;
    justify-content: start;
    text-align: left;
  }

  .timeline-item {
    padding-left: 27px;
  }

  .timeline-card {
    padding: 17px;
  }

  .blog-content {
    padding: 18px;
  }

  .accordion-header {
    min-height: 58px;
    padding: 15px;
    font-size: .88rem;
  }

  .accordion-content p {
    padding-inline: 15px;
  }

  .cta-buttons {
    display: grid;
    grid-template-columns: 1fr;
    width: min(100%, 340px);
    margin-inline: auto;
  }

  .card {
    padding: 19px;
  }

  .footer {
    padding-top: 48px;
  }

  .footer-grid {
    grid-template-columns: 1fr;
    gap: 27px;
  }

  .footer-bottom-container {
    min-height: 74px;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    padding-block: 14px;
    text-align: center;
  }

  .floating-buttons {
    right: 14px;
    bottom: 16px;
    gap: 8px;
  }

  .float-btn {
    width: 47px;
    height: 47px;
    font-size: 1.12rem;
  }

  .back-to-top {
    right: 18px;
    bottom: 128px;
  }
}

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: .01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .01ms !important;
  }
}
